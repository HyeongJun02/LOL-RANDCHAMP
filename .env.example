# Neon 콘솔 > 프로젝트 > Data API 탭에서 나오는 Base URL을 복사해서
# .env.local (git에 안 올라감) 파일을 만들고 여기에 붙여넣으세요.
# 형태 예시: https://ep-xxx.c-2.us-east-2.aws.neon.build/dbname
REACT_APP_NEON_BASE_URL=https://ep-soft-math-av67dj78.apirest.c-11.us-east-1.aws.neon.tech/neondb/rest/v1

# 라이엇 API 키 (전적 · 정보 페이지). https://developer.riotgames.com 에서 받는다.
# REACT_APP_를 붙이지 말 것 - 붙이면 화면 코드에 실려 누구나 꺼내 간다.
# 배포 사이트는 Vercel · Netlify 대시보드의 환경변수에 같은 이름으로 넣는다.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
